# ColdGuard production edge image - ESP32-S3 (CG-HW-001, pin map v2).
#
# These are the options the release candidate is actually built with. They are
# committed so a reviewer reproduces the same bytes instead of inheriting
# whatever `idf.py set-target` happens to default to.
#
# Flash size stays 2 MB because that is the layout already proven on this board
# by the H6/H8 bench builds; the package holds 4 MB, so the upper half is simply
# unused. Widen it only with a deliberate partition-table change.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# The controller's only proven console path is the native USB-Serial/JTAG port
# (COM4, VID:PID 303A:1001). Left at the IDF default the primary console is
# UART0 and COM4 becomes secondary, which still shows logs but does not accept
# the command console - so the operator could read the device and not drive it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
