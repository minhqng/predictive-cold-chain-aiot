# Local environment secrets (templates such as infra/.env.example stay versioned).
.env
.env.*
!.env.example

# Provisioned broker credentials (C-W02-01): generated per checkout by
# infra/mosquitto/provision-dev.sh, never committed.
infra/mosquitto/passwd
infra/mosquitto/passwd.tmp

# Python artifacts and local environments.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# ESP-IDF build output.
firmware/build/
# Configured per-bench IDF trees (~150 MB each) and the sdkconfig files CMake
# generates from sdkconfig.defaults. Only sdkconfig.defaults is a source file.
firmware/*-bench/build*/
firmware/*-bench/sdkconfig
firmware/*-bench/sdkconfig.old
# Flash images and region readbacks stay local; their SHA-256 and size are
# pinned in evidence/A/W04/ARTIFACT-MANIFEST.md.
evidence/A/W04/**/*.bin

# Future frontend dependency and build output.
frontend/node_modules/
frontend/dist/
frontend/.next/

# Local runtime noise. Exception: raw evidence logs are versioned and
# pinned by SHA-256 in the W02/W03 evidence validators, so they must
# survive a clean checkout (the W02 dossier was shipped without its reboot
# log because of this rule).
*.log
!evidence/**/*.log
.DS_Store
Thumbs.db
.idea/
