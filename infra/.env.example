# Development-only placeholder values for `docker compose --env-file infra/.env.example`.
# Never commit real credentials. Copy to `.env` (git-ignored) for local runs.
#
# Host-runtime defaults below use localhost. Inside Compose the backend
# service overrides POSTGRES_HOST/MQTT_HOST with Compose service names
# (postgres, mosquitto); see infra/compose.yaml and
# backend/src/coldguard_backend/config.py.
COLDGUARD_PROFILE=dev
POSTGRES_DB=coldguard
POSTGRES_USER=coldguard
POSTGRES_PASSWORD=coldguard_dev_only
POSTGRES_PORT=5432
MQTT_HOST=localhost
MQTT_PORT=1883
# Mosquitto development identities (C-W02-01). Placeholder values only;
# real per-checkout passwords belong in an untracked `.env`, never here.
# infra/mosquitto/provision-dev.sh turns these into the git-ignored
# `infra/mosquitto/passwd` file consumed by the broker.
MOSQUITTO_DEVICE_USER=device-coldguard-001
MOSQUITTO_DEVICE_PASSWORD=device_dev_only
MOSQUITTO_BACKEND_USER=backend-ingest
MOSQUITTO_BACKEND_PASSWORD=backend_dev_only
# Backend MQTT ingestion consumer (C-W02-03): "true" starts the real
# subscriber inside the backend process; anything else keeps HTTP-only.
COLDGUARD_MQTT_INGEST=true
# Opt in only with a provisioned backend identity and the command migration.
COLDGUARD_MQTT_ACK_INGEST=false
# Opt in after migrations to reconcile audit state on backend startup.
COLDGUARD_RECONCILE_COMMANDS=false
BACKEND_PORT=8000
